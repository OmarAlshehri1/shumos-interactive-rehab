# typescript
*.tsbuildinfo
next-env.d.ts

# TASK 10 — local Audar-TTS-V1-Flash service: model weights, vendored
# upstream source, Python virtual env, and generated audio are all large
# and/or regenerable — never committed. Downloaded/derived fresh by
# scripts/start-tts.sh on each machine. See tts-service/THIRD_PARTY_NOTICES.md.
tts-service/.venv/
tts-service/vendor/
tts-service/models/
tts-service/cache/
tts-service/voices/*.wav
tts-service/voices/*.json
*.gguf
database-debug.log
tts-service/test_output.wav
