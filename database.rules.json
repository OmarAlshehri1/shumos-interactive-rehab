{
  "rules": {
    ".read": false,
    ".write": false,

    "liveSession": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true && (!data.exists() || !newData.exists() || newData.child('revision').val() > data.child('revision').val())",
      ".validate": "newData.hasChildren(['gameId', 'sessionId', 'revision', 'session', 'updatedAt'])",

      "gameId": { ".validate": "newData.isString() && (newData.val() == 'balloon-quest' || newData.val() == 'follow-the-footsteps' || newData.val() == 'bubble-pop-wall' || newData.val() == 'feed-the-animals' || newData.val() == 'space-pilot' || newData.val() == 'color-chase')" },
      "sessionId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 100" },
      "revision": { ".validate": "newData.isNumber() && newData.val() > 0" },

      "session": {
        ".validate": "newData.hasChildren(['sessionId', 'seed', 'config', 'gameState', 'currentDifficulty', 'currentStage', 'createdAt'])",
        "config": {
          "childFirstName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "$other": { ".validate": true }
        },
        "$other": { ".validate": true }
      },

      "lastInteraction": {
        ".validate": "newData.val() == null || newData.hasChildren(['id', 'type', 'balloonId', 'revision', 'timestamp'])"
      },

      "celebrationReplay": {
        ".validate": "newData.val() == null || newData.hasChildren(['token', 'timestamp'])"
      },

      "patientId": {
        ".validate": "newData.val() == null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 60)"
      },

      "updatedAt": { ".validate": true }
    },

    "controllerLease": {
      ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
      ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true && (!data.exists() || data.child('ownerId').val() == auth.uid || (now - data.child('updatedAt').val()) > 45000)",
      ".validate": "!newData.exists() || (newData.hasChildren(['ownerId', 'claimedAt']) && newData.child('ownerId').val() == auth.uid)"
    },

    "presence": {
      "controller": {
        ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
        ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
        ".validate": "!newData.exists() || newData.hasChild('connected')"
      },
      "display": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "!newData.exists() || newData.hasChild('connected')"
      }
    },

    "staff": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        ".validate": "newData.hasChildren(['active', 'role'])",
        "active": { ".validate": "newData.isBoolean()" },
        "role": { ".validate": "newData.isString() && (newData.val() == 'therapist' || newData.val() == 'admin')" },
        "$other": { ".validate": true }
      }
    },

    "patients": {
      ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
      "$patientId": {
        ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
        ".validate": "newData.hasChildren(['patientNumber', 'firstName', 'createdAt', 'updatedAt', 'createdByUid', 'active'])",

        "patientNumber": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40 && (!data.exists() || newData.val() == data.val())"
        },
        "firstName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
        },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "createdByUid": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())"
        },
        "active": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },

    "patientNumbers": {
      ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
      "$normalizedNumber": {
        ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true && !data.exists()",
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
      }
    },

    "sessions": {
      ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
      "$historyPatientId": {
        "$sessionId": {
          ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true && !data.exists()",
          ".validate": "newData.hasChildren(['sessionId', 'patientId', 'gameId', 'startedAt', 'completedAt', 'createdByUid', 'startingDifficulty', 'startingStage', 'endingDifficulty', 'endingStage', 'completedStageCount', 'skippedStageCount']) && newData.child('patientId').val() == $historyPatientId && newData.child('sessionId').val() == $sessionId && ((newData.child('gameId').val() == 'balloon-quest' && newData.hasChildren(['totalCorrect', 'totalIncorrect'])) || (newData.child('gameId').val() == 'follow-the-footsteps' && newData.hasChildren(['totalStepsPresented', 'totalStepsCompleted'])) || (newData.child('gameId').val() == 'bubble-pop-wall' && newData.hasChildren(['totalTargetsPresented', 'totalTargetsCompleted', 'totalIncorrect'])) || (newData.child('gameId').val() == 'feed-the-animals' && newData.hasChildren(['totalRoundsPresented', 'totalRoundsCompleted', 'totalIncorrect'])) || (newData.child('gameId').val() == 'space-pilot' && newData.hasChildren(['totalStarsPresented', 'totalStarsCollected'])) || (newData.child('gameId').val() == 'color-chase' && newData.hasChildren(['totalTargetsPresented', 'totalCorrect', 'totalIncorrect', 'totalDangerPresses'])))",

          "sessionId": { ".validate": "newData.isString() && newData.val() == $sessionId" },
          "patientId": { ".validate": "newData.isString() && newData.val() == $historyPatientId" },
          "gameId": { ".validate": "newData.isString() && (newData.val() == 'balloon-quest' || newData.val() == 'follow-the-footsteps' || newData.val() == 'bubble-pop-wall' || newData.val() == 'feed-the-animals' || newData.val() == 'space-pilot' || newData.val() == 'color-chase')" },
          "startedAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "completedAt": { ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('startedAt').val()" },
          "createdByUid": { ".validate": "newData.isString() && newData.val() == auth.uid" },
          "therapistName": { ".validate": "newData.val() == null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 80)" },
          "sessionGoal": { ".validate": "newData.val() == null || (newData.isString() && (newData.val() == 'MOVEMENT_REACH' || newData.val() == 'VISUAL_DISCRIMINATION' || newData.val() == 'FOLLOWING_INSTRUCTIONS' || newData.val() == 'BALANCE_TRANSITION' || newData.val() == 'INTERACTION_RESPONSE' || newData.val() == 'OTHER'))" },
          "customSessionGoal": { ".validate": "newData.val() == null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 100)" },
          "endReason": { ".validate": "newData.val() == null || (newData.isString() && (newData.val() == 'CHILD_SATISFIED' || newData.val() == 'CHILD_TIRED' || newData.val() == 'CHANGE_ACTIVITY' || newData.val() == 'OTHER'))" },
          "customEndReason": { ".validate": "newData.val() == null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 120)" },
          "therapistNote": {
            ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true && data.parent().child('createdByUid').val() == auth.uid",
            ".validate": "newData.val() == null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 750)"
          },

          "startingDifficulty": { ".validate": "newData.isString() && (newData.val() == 'EASY' || newData.val() == 'MEDIUM' || newData.val() == 'ADVANCED')" },
          "startingStage": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
          "endingDifficulty": { ".validate": "newData.isString() && (newData.val() == 'EASY' || newData.val() == 'MEDIUM' || newData.val() == 'ADVANCED')" },
          "endingStage": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },

          "completedStageCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "skippedStageCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "totalCorrect": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "totalIncorrect": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "accuracy": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "averageReactionTimeMs": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)" },

          "totalStepsPresented": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "totalStepsCompleted": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "completionRate": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "averageStepTimeMs": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)" },

          "totalTargetsPresented": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "totalTargetsCompleted": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "totalDangerPresses": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "averageResponseTimeMs": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)" },

          "totalRoundsPresented": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "totalRoundsCompleted": { ".validate": "newData.isNumber() && newData.val() >= 0" },

          "totalStarsPresented": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "totalStarsCollected": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "collectionRate": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "finalUpgradeLevel": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)" },
          "asteroidsCleared": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)" },
          "asteroidsAvoided": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)" },

          "durationMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "bestStage": { ".validate": "newData.val() == null || newData.hasChildren(['difficulty', 'stageNumber'])" },
          "stageResults": { ".validate": true },

          "$other": { ".validate": false }
        }
      }
    }
  }
}
