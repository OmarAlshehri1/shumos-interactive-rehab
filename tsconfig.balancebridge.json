{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next-balancebridge/balance.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    ".next-balancebridge/types/**/*.ts",
    ".next-balancebridge/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".next-balancebridge/cache"]
}
