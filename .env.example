MUNSIT_API_KEY=
# Explicitly set false to disable paid TTS upstream calls. Unset/true keeps Munsit enabled.
MUNSIT_TTS_ENABLED=true

# Firebase Web SDK config (Realtime Database only). Not a server secret —
# see lib/realtime/firebaseClient.ts. Get these from the Firebase Console:
# Project settings > General > Your apps > Web app > SDK setup and config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Dev-only: point the app at local Realtime Database + Auth emulators
# instead of the real project. Leave all three unset in every real deployment.
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_EMULATOR_PORT=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=

# Game release flags (build-time; changing one needs a rebuild/redeploy). See docs/release/FOUR_GAME_RELEASE_REPORT.md.
# Production release configuration:
#   NEXT_PUBLIC_SPACE_PILOT_3D_ENABLED=true   (false/unset in production = original Space Pilot)
#   NEXT_PUBLIC_BUILD_QUEST_3D_ENABLED=true   (false/unset = Build Quest card and routes removed)
#   NEXT_PUBLIC_RUNNER_QUEST_3D=1             (0/unset = Runner Quest card and routes removed)
#   NEXT_PUBLIC_SAFE_HEX_ARENA_3D=true        (false/unset = Safe Hex Arena card and routes removed)
#   NEXT_PUBLIC_FOOTSTEPS_3D=true             (false/unset = the original Follow the Footsteps is served)
#   NEXT_PUBLIC_COLOR_CHASE_3D=true           (false/unset = the original Color Chase is served)
#   NEXT_PUBLIC_BALLOON_QUEST_LEGACY=1        (rollback only: serves the original Balloon Quest; leave unset for the new game)
NEXT_PUBLIC_SPACE_PILOT_3D_ENABLED=
NEXT_PUBLIC_BUILD_QUEST_3D_ENABLED=
NEXT_PUBLIC_RUNNER_QUEST_3D=
NEXT_PUBLIC_SAFE_HEX_ARENA_3D=
NEXT_PUBLIC_FOOTSTEPS_3D=
NEXT_PUBLIC_COLOR_CHASE_3D=
NEXT_PUBLIC_BALLOON_QUEST_LEGACY=

# Wonder Dome replaces the canonical Bubble Pop Wall; 0 restores legacy Control.
NEXT_PUBLIC_BUBBLE_POP_WALL_3D=1

# Fire Rescue 3D: dev defaults on, production requires explicit opt-in. Hardware validation pending.
NEXT_PUBLIC_FIRE_RESCUE_3D=false

# Pearl Voyage 3D (قارب اللؤلؤ): dev defaults on, production requires explicit opt-in. Wheel/pedal hardware validation pending.
NEXT_PUBLIC_PEARL_VOYAGE_3D=false

# Blooming World 3D: production opt-in; false disables both routes and library card.
NEXT_PUBLIC_BLOOMING_WORLD_3D=false

# Harvest Valley 3D — enable only in an approved batch release.
NEXT_PUBLIC_HARVEST_VALLEY_3D=false

# Mirror Quest 3D: production requires explicit opt-in; false disables both canonical routes and its library card.
NEXT_PUBLIC_MIRROR_QUEST_3D=false

# Unified floor games: enable only after the reviewed merged Firebase rules are published.
NEXT_PUBLIC_BALANCE_BRIDGE_3D=false
NEXT_PUBLIC_TURN_AND_GO_3D=false
NEXT_PUBLIC_FOOT_MAZE_3D=false
NEXT_PUBLIC_RHYTHM_STEPS_3D=false
NEXT_PUBLIC_BODY_SEQUENCE_3D=false

# Server-only official YouTube search. Never use NEXT_PUBLIC_ for this key.
YOUTUBE_API_KEY=
# Therapist-confirmed visual rewards: local development defaults on; production requires an approved opt-in.
NEXT_PUBLIC_ACHIEVEMENT_CITY_3D=false
NEXT_PUBLIC_ACHIEVEMENT_FOREST_3D=false
NEXT_PUBLIC_OCEAN_WONDERS_3D=false
