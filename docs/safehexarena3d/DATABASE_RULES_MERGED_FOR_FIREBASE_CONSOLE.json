    },
    "spacePilot3d": {
      "presence": {
        "$sessionId": {
          ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
          "$displayUid": {
            ".write": "auth != null && auth.uid == $displayUid && auth.token.firebase.sign_in_provider == 'anonymous' && newData.exists()",
            ".validate": "newData.hasChildren(['version','type','displayId','ownerId','sessionId','runId','inputEpoch','frameSequence','sequence','visible','ready','updatedAt']) && newData.child('ownerId').val() == root.child('liveSession').child('session').child('sp3').child('ownerToken').val() && newData.child('sessionId').val() == $sessionId && newData.child('runId').val() == root.child('liveSession').child('session').child('sp3').child('run').val() && root.child('liveSession').child('gameId').val() == 'space-pilot' && root.child('liveSession').child('sessionId').val() == $sessionId && root.child('liveSession').child('updatedAt').val() > now - 20000 && (!data.exists() || newData.child('displayId').val() != data.child('displayId').val() || newData.child('ownerId').val() != data.child('ownerId').val() || newData.child('sequence').val() > data.child('sequence').val())",
