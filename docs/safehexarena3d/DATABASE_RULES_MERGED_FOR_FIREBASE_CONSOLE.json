          },
          "endingStage": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
          },
          "completedStageCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "skippedStageCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalCorrect": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalIncorrect": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "accuracy": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
          },
          "averageReactionTimeMs": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)"
          },
          "totalStepsPresented": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalStepsCompleted": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "completionRate": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
          },
          "averageStepTimeMs": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)"
          },
          "totalTargetsPresented": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalTargetsCompleted": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalDangerPresses": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "averageResponseTimeMs": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)"
          },
          "totalRoundsPresented": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalRoundsCompleted": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalStarsPresented": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalStarsCollected": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "collectionRate": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1 && (newData.parent().child('gameId').val() != 'space-pilot' || newData.parent().child('resultVersion').val() != 2 || (newData.parent().child('totalRingsPresented').val() > 0 && newData.val() == newData.parent().child('totalRingsCollected').val() / newData.parent().child('totalRingsPresented').val()))"
          },
          "finalUpgradeLevel": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 3)"
          },
          "asteroidsCleared": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)"
          },
          "asteroidsAvoided": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)"
          },
          "resultVersion": {
            ".validate": "(newData.isNumber() && newData.val() >= 1) || (newData.parent().child('gameId').val() == 'build-quest-3d' && newData.val() == 1)"
          },
          "totalStars": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalHolds": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalAssists": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.parent().child('gameId').val() != 'mirror-quest-3d' || (newData.val() <= newData.parent().child('totalPoses').val() && newData.val() % 1 == 0))"
          },
          "totalObstaclesPresented": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalObstaclesResolved": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
