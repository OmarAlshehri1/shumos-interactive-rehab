            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            },
            "displayId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "ownerId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "sessionId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "runId": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 == 0"
            },
            "inputEpoch": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 == 0"
            },
            "frameSequence": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 == 0"
            },
            "sequence": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 == 0"
            }
          }
        }
      },
      "sensor": {
        ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
        "$sessionId": {
          ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true && root.child('liveSession').child('session').child('sp3').child('ownerId').val() == auth.uid && root.child('liveSession').child('gameId').val() == 'space-pilot' && root.child('liveSession').child('sessionId').val() == $sessionId && root.child('liveSession').child('updatedAt').val() > now - 20000 && newData.exists() && (!data.exists() || data.child('updatedAt').val() <= now - 3000 || data.child('ownerId').val() != newData.child('ownerId').val() || (data.child('sourceToken').val() == newData.child('sourceToken').val() && newData.child('sequence').val() > data.child('sequence').val()))",
          ".validate": "newData.hasChildren(['sampleAgeMs','version','role','ownerId','epoch','runId','inputEpoch','sourceToken','sequence','x','y','visible','updatedAt']) && newData.child('ownerId').val() == root.child('liveSession').child('session').child('sp3').child('ownerToken').val() && newData.child('epoch').val() == root.child('liveSession').child('session').child('sp3').child('epoch').val() && newData.child('runId').val() == root.child('liveSession').child('session').child('sp3').child('run').val()",
          "version": {
            ".validate": "newData.val() == 1"
          },
          "role": {
            ".validate": "newData.val() == 'RIGHT_HAND'"
          },
          "ownerId": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "sourceToken": {
            ".validate": "newData.isString() && newData.val().length == 36"
          },
          "visible": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          },
          "epoch": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000000 && newData.val() % 1 == 0"
          },
          "runId": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000000 && newData.val() % 1 == 0"
          },
          "inputEpoch": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000000 && newData.val() % 1 == 0"
          },
          "sequence": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000000 && newData.val() % 1 == 0"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
          },
          "sampleAgeMs": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 250"
          }
        }
      }
    }
  }
}
