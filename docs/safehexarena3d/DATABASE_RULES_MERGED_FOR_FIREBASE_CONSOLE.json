{
  "rules": {
    ".read": false,
    ".write": false,
    "liveSession": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true && (!data.exists() || !newData.exists() || newData.child('revision').val() > data.child('revision').val()) && (newData.child('gameId').val() != 'mirror-quest-3d' || (root.child('controllerLease').child('ownerId').val() == auth.uid && newData.child('session').child('mirror3').child('ownerId').val() == auth.uid)) && (newData.child('gameId').val() != 'safe-hex-arena-3d' || (root.child('controllerLease').child('ownerId').val() == auth.uid && newData.child('session').child('hex3').child('ownerId').val() == auth.uid))",
      ".validate": "newData.hasChildren(['gameId', 'sessionId', 'revision', 'session', 'updatedAt'])",
      "gameId": {
        ".validate": "newData.isString() && (newData.val() == 'balloon-quest' || newData.val() == 'follow-the-footsteps' || newData.val() == 'bubble-pop-wall' || newData.val() == 'feed-the-animals' || newData.val() == 'space-pilot' || newData.val() == 'color-chase' || newData.val() == 'runner-quest-3d' || newData.val() == 'build-quest-3d' || newData.val() == 'mirror-quest-3d' || newData.val() == 'safe-hex-arena-3d')"
      },
      "sessionId": {
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 100"
      },
      "revision": {
        ".validate": "newData.isNumber() && newData.val() > 0"
      },
      "session": {
        ".validate": "newData.hasChildren(['sessionId', 'seed', 'config', 'gameState', 'currentDifficulty', 'currentStage', 'createdAt']) && (newData.parent().child('gameId').val() != 'mirror-quest-3d' || (newData.child('engine').val() == 'mirror3' && newData.child('engineVersion').val() == 1 && newData.child('mirror3').hasChildren(['ownerId','payload','controlTabId','heartbeatAt']) && newData.child('mirror3').child('payload').isString() && newData.child('mirror3').child('payload').val().length <= 32768)) && (newData.parent().child('gameId').val() != 'safe-hex-arena-3d' || (newData.child('engine').val() == 'hex3' && newData.child('engineVersion').val() == 1 && newData.child('hex3').hasChildren(['ownerId','payload','controlTabId','heartbeatAt']) && newData.child('hex3').child('payload').isString() && newData.child('hex3').child('payload').val().length <= 32768))",
        "config": {
          "childFirstName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "$other": {
            ".validate": true
          }
        },
        "$other": {
          ".validate": true
        }
      },
      "lastInteraction": {
        ".validate": "newData.val() == null || newData.hasChildren(['id', 'type', 'balloonId', 'revision', 'timestamp'])"
      },
      "celebrationReplay": {
        ".validate": "newData.val() == null || newData.hasChildren(['token', 'timestamp'])"
      },
      "patientId": {
        ".validate": "!newData.exists()"
      },
      "updatedAt": {
        ".validate": true
      }
    },
    "liveSessionPrivate": {
      ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
      ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
      ".validate": "!newData.exists() || newData.hasChildren(['sessionId', 'patientId', 'updatedAt'])",
      "sessionId": {
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 100"
      },
      "patientId": {
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
      },
      "updatedAt": {
        ".validate": "newData.isNumber()"
      },
      "$other": {
        ".validate": false
      }
    },
    "controllerLease": {
      ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
      ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true && (!data.exists() || data.child('ownerId').val() == auth.uid || (now - data.child('updatedAt').val()) > 45000)",
      ".validate": "!newData.exists() || (newData.hasChildren(['ownerId', 'claimedAt']) && newData.child('ownerId').val() == auth.uid)"
    },
    "presence": {
      "controller": {
        ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
        ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
        ".validate": "!newData.exists() || newData.hasChild('connected')"
      },
      "display": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "!newData.exists() || newData.hasChild('connected')"
      }
    },
    "staff": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        ".validate": "newData.hasChildren(['active', 'role'])",
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() == 'therapist' || newData.val() == 'admin')"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "patients": {
      ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
      "$patientId": {
        ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
        ".validate": "newData.hasChildren(['patientNumber', 'firstName', 'createdAt', 'updatedAt', 'createdByUid', 'active'])",
        "patientNumber": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40 && (!data.exists() || newData.val() == data.val())"
        },
        "firstName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "createdByUid": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "patientNumbers": {
      ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
      "$normalizedNumber": {
        ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true && !data.exists()",
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
      }
    },
    "sessions": {
      ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true",
      "$historyPatientId": {
        "$sessionId": {
          ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true && !data.exists() && (newData.child('gameId').val() != 'build-quest-3d' || root.child('patients').child($historyPatientId).exists()) && (newData.child('gameId').val() != 'space-pilot' || !newData.child('resultVersion').exists() || root.child('patients').child($historyPatientId).exists()) && (newData.child('gameId').val() != 'mirror-quest-3d' || root.child('patients').child($historyPatientId).exists()) && (newData.child('gameId').val() != 'safe-hex-arena-3d' || root.child('patients').child($historyPatientId).exists())",
          ".validate": "newData.hasChildren(['sessionId', 'patientId', 'gameId', 'startedAt', 'completedAt', 'createdByUid', 'startingDifficulty', 'startingStage', 'endingDifficulty', 'endingStage', 'completedStageCount', 'skippedStageCount']) && newData.child('patientId').val() == $historyPatientId && newData.child('sessionId').val() == $sessionId && ((newData.child('gameId').val() == 'balloon-quest' && newData.hasChildren(['totalCorrect', 'totalIncorrect'])) || (newData.child('gameId').val() == 'follow-the-footsteps' && newData.hasChildren(['totalStepsPresented', 'totalStepsCompleted'])) || (newData.child('gameId').val() == 'bubble-pop-wall' && newData.hasChildren(['totalTargetsPresented', 'totalTargetsCompleted', 'totalIncorrect'])) || (newData.child('gameId').val() == 'feed-the-animals' && newData.hasChildren(['totalRoundsPresented', 'totalRoundsCompleted', 'totalIncorrect'])) || (newData.child('gameId').val() == 'space-pilot' && ((!newData.child('resultVersion').exists() && newData.hasChildren(['totalStarsPresented','totalStarsCollected'])) || (newData.child('resultVersion').val() == 2 && newData.child('engine').val() == 'sp3-rings' && newData.hasChildren(['totalRingsPresented','totalRingsCollected','totalRingsMissed','asteroidCollisions','score','runId','flightMode']) && !newData.child('totalStarsPresented').exists() && !newData.child('totalStarsCollected').exists()))) || (newData.child('gameId').val() == 'color-chase' && newData.hasChildren(['totalTargetsPresented', 'totalCorrect', 'totalIncorrect', 'totalDangerPresses'])) || (newData.child('gameId').val() == 'runner-quest-3d' && newData.hasChildren(['resultVersion', 'totalStars', 'totalHolds', 'totalAssists', 'totalObstaclesPresented', 'totalObstaclesResolved'])) || (newData.child('gameId').val() == 'mirror-quest-3d' && newData.hasChildren(['resultVersion','totalPoses','totalAssists']) && newData.child('resultVersion').val() == 1) || (newData.child('gameId').val() == 'safe-hex-arena-3d' && newData.hasChildren(['resultVersion','totalRoundsPresented','totalRoundsCompleted','totalSafeTransitions','totalAssists']) && newData.child('resultVersion').val() == 1) || (newData.child('gameId').val() == 'build-quest-3d' && newData.hasChildren(['resultVersion','totalPiecesPlaced']) && newData.child('resultVersion').val() == 1)) && (newData.child('gameId').val() != 'space-pilot' || newData.child('resultVersion').val() != 2 || (!newData.child('asteroidsCleared').exists() && !newData.child('stageResults').exists()))",
          "sessionId": {
            ".validate": "newData.isString() && newData.val() == $sessionId"
          },
          "patientId": {
            ".validate": "newData.isString() && newData.val() == $historyPatientId"
          },
          "gameId": {
            ".validate": "newData.isString() && (newData.val() == 'balloon-quest' || newData.val() == 'follow-the-footsteps' || newData.val() == 'bubble-pop-wall' || newData.val() == 'feed-the-animals' || newData.val() == 'space-pilot' || newData.val() == 'color-chase' || newData.val() == 'runner-quest-3d' || newData.val() == 'build-quest-3d' || newData.val() == 'mirror-quest-3d' || newData.val() == 'safe-hex-arena-3d')"
          },
          "startedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "completedAt": {
            ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('startedAt').val()"
          },
          "createdByUid": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "therapistName": {
            ".validate": "newData.val() == null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 80)"
          },
          "sessionGoal": {
            ".validate": "newData.val() == null || (newData.isString() && (newData.val() == 'MOVEMENT_REACH' || newData.val() == 'VISUAL_DISCRIMINATION' || newData.val() == 'FOLLOWING_INSTRUCTIONS' || newData.val() == 'BALANCE_TRANSITION' || newData.val() == 'INTERACTION_RESPONSE' || newData.val() == 'OTHER'))"
          },
          "customSessionGoal": {
            ".validate": "newData.val() == null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 100)"
          },
          "endReason": {
            ".validate": "newData.val() == null || (newData.isString() && (newData.val() == 'CHILD_SATISFIED' || newData.val() == 'CHILD_TIRED' || newData.val() == 'CHANGE_ACTIVITY' || newData.val() == 'OTHER'))"
          },
          "customEndReason": {
            ".validate": "newData.val() == null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 120)"
          },
          "therapistNote": {
            ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() == true && data.parent().child('createdByUid').val() == auth.uid",
            ".validate": "newData.val() == null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 750)"
          },
          "startingDifficulty": {
            ".validate": "newData.isString() && (newData.val() == 'EASY' || newData.val() == 'MEDIUM' || newData.val() == 'ADVANCED')"
          },
