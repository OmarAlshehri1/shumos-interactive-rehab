          },
          "durationMs": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "bestStage": {
            ".validate": "newData.val() == null || newData.hasChildren(['difficulty', 'stageNumber'])"
          },
          "stageResults": {
            ".validate": true,
            "$row": {
              ".validate": "newData.parent().parent().child('gameId').val() != 'build-quest-3d' || (($row == '0' || $row == '1' || $row == '2' || $row == '3' || $row == '4' || $row == '5' || $row == '6' || $row == '7' || $row == '8') && newData.hasChildren(['engine','stageId','difficulty','stageNumber','status','piecesPlaced']))",
              "engine": {
                ".validate": "newData.parent().parent().parent().child('gameId').val() != 'build-quest-3d' || newData.val() == 'build3'"
              },
              "stageId": {
                ".validate": "newData.parent().parent().parent().child('gameId').val() != 'build-quest-3d' || (newData.isString() && newData.val().length > 0 && newData.val().length <= 80)"
              },
              "difficulty": {
