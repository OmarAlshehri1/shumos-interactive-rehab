              },
              "piecesPlaced": {
                ".validate": "newData.parent().parent().parent().child('gameId').val() != 'build-quest-3d' || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 10 && newData.val() % 1 == 0)"
              },
              "durationMs": {
                ".validate": "newData.parent().parent().parent().child('gameId').val() != 'build-quest-3d' || newData.val() == null"
              },
              "$other": {
                ".validate": "newData.parent().parent().parent().child('gameId').val() != 'build-quest-3d'"
              }
            }
          },
          "$other": {
            ".validate": false
          },
          "totalPiecesPlaced": {
            ".validate": "newData.parent().child('gameId').val() == 'build-quest-3d' && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 == 0"
          },
          "totalRingsPresented": {
            ".validate": "newData.parent().child('gameId').val() == 'space-pilot' && newData.parent().child('resultVersion').val() == 2 && newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0"
          },
          "totalRingsCollected": {
            ".validate": "newData.parent().child('gameId').val() == 'space-pilot' && newData.parent().child('resultVersion').val() == 2 && newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0"
          },
          "totalRingsMissed": {
            ".validate": "newData.parent().child('gameId').val() == 'space-pilot' && newData.parent().child('resultVersion').val() == 2 && newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0 && newData.val() <= newData.parent().child('totalRingsPresented').val() - newData.parent().child('totalRingsCollected').val()"
          },
          "asteroidCollisions": {
            ".validate": "newData.parent().child('gameId').val() == 'space-pilot' && newData.parent().child('resultVersion').val() == 2 && newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0"
          },
          "score": {
            ".validate": "newData.parent().child('gameId').val() == 'space-pilot' && newData.parent().child('resultVersion').val() == 2 && newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0 && newData.val() == newData.parent().child('totalRingsCollected').val() * 100"
          },
          "runId": {
            ".validate": "newData.parent().child('gameId').val() == 'space-pilot' && newData.parent().child('resultVersion').val() == 2 && newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0"
          },
          "engine": {
            ".validate": "newData.parent().child('gameId').val() == 'space-pilot' && newData.parent().child('resultVersion').val() == 2 && newData.val() == 'sp3-rings'"
          },
          "flightMode": {
